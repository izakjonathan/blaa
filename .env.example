# Required only for editor saving/publishing. Use a dedicated database.
DATABASE_URL=
# Private Vercel Blob store, required for new photo uploads.
BLOB_READ_WRITE_TOKEN=

# Optional internal stock-order emails. Keep disabled until admin/API access is protected.
STOCK_ORDER_EMAIL_ENABLED=false
RESEND_API_KEY=
# Verified sender and one internal recipient (plain email addresses).
STOCK_ORDER_FROM=
STOCK_ORDER_TO=

# Optional private Google Sheets catalog for Stock Control.
STOCK_SHEET_ID=
STOCK_SHEET_SERVICE_ACCOUNT_JSON=
# Random server-side key of at least 32 characters. Required when Sheets sync is enabled.
STOCK_ACCESS_KEY=
